# Copy this file to .env and fill in your values.

# Base URL of the OpenAI-compatible endpoint (no trailing slash, without /v1).
# The script appends /v1/chat/completions itself.
LLM_OPENAI_API_URL=https://your-llm-endpoint.example.com

# API key sent as "Authorization: Bearer <key>".
LLM_OPENAI_API_KEY=your-api-key-here

# Default model ID to test (can be overridden by the script's first argument).
LLM_OPENAI_MODEL=your-model-id
